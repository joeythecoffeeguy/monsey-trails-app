{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "coach-passenger-display.replit.app"
      },
      "android": {
        "image": "latest",
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      }
    }
  }
}